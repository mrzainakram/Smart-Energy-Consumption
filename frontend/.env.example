# Frontend Environment Variables for Vercel Deployment
# Copy this to .env.local for local development

# Backend API URL (Replace with your actual backend URL)
VITE_BACKEND_API_URL=https://your-backend-url.vercel.app

# Streamlit Chatbot URL (Replace with your actual Streamlit URL)
VITE_STREAMLIT_CHATBOT_URL=https://your-streamlit-app.streamlit.app

# Optional: Google OAuth (if using Google login)
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Optional: App Version
VITE_APP_VERSION=3.0.0
